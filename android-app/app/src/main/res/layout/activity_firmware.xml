<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bruce_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/firmwareBackButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/firmware_title"
                android:textColor="@color/bruce_primary"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/firmware_safety_summary"
            android:textColor="@color/bruce_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/target_profile"
                android:textColor="@color/bruce_text"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/firmwareProfileSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/target_profile"
                android:popupBackground="@color/bruce_surface_variant" />

            <TextView
                android:id="@+id/bootInstructionsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="@color/bruce_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usb_device"
                android:textColor="@color/bruce_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/firmwareDeviceSpinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/usb_device"
                    android:popupBackground="@color/bruce_surface_variant" />

                <Button
                    android:id="@+id/firmwareScanButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/scan" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_from_github"
                android:textColor="@color/bruce_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/download_from_github_description"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/checkGitHubButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/check_github_releases" />

            <ProgressBar
                android:id="@+id/githubProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/githubStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/github_status_idle"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/downloadFirmwareButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="@string/download_firmware"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/merged_firmware"
                android:textColor="@color/bruce_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/merged_firmware_description"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chooseMergedButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_merged_bin" />

            <TextView
                android:id="@+id/mergedFileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/no_file_selected"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/signed_brp1_patch"
                android:textColor="@color/bruce_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/signed_brp1_description"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chooseBaseButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_exact_base_bin" />

            <TextView
                android:id="@+id/baseFileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_file_selected"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chooseManifestButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/choose_manifest" />

            <TextView
                android:id="@+id/manifestFileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_file_selected"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chooseSignatureButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/choose_der_signature" />

            <TextView
                android:id="@+id/signatureFileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_file_selected"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/choosePatchButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/choose_brp1_payload" />

            <TextView
                android:id="@+id/patchFileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_file_selected"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/applyPatchButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/verify_and_apply_patch" />

            <TextView
                android:id="@+id/patchStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/patch_waiting"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ready_to_flash"
                android:textColor="@color/bruce_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/readyFirmwareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:text="@string/no_firmware_ready"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/identifyTargetButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/identify_target" />

            <TextView
                android:id="@+id/detectedTargetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/target_not_identified"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/firmwareProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/firmwareProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/progress_idle"
                android:textColor="@color/bruce_text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/flashFirmwareButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/flash_firmware" />

                <Button
                    android:id="@+id/cancelFirmwareButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/cancel" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/firmwareStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:text="@string/firmware_status_ready"
            android:textColor="@color/bruce_text_muted"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
